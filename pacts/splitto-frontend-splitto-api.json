{
  "consumer": {
    "name": "splitto-frontend"
  },
  "interactions": [
    {
      "description": "a request for balances of a non-existent group",
      "providerStates": [
        {
          "name": "aucun groupe inexistant"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/groups/inexistant/balances"
      },
      "response": {
        "body": {
          "error": "Group not found"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 404
      }
    },
    {
      "description": "a request for balances of group-1",
      "providerStates": [
        {
          "name": "group-1 a 3 membres et 2 dépenses"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/groups/group-1/balances"
      },
      "response": {
        "body": {
          "balances": {
            "alice": 20,
            "bob": -10,
            "carol": -10
          },
          "groupId": "group-1",
          "settlements": [
            {
              "amount": 10,
              "from": "bob",
              "to": "alice"
            },
            {
              "amount": 10,
              "from": "carol",
              "to": "alice"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "13.2.0"
    },
    "pactRust": {
      "ffi": "0.4.22",
      "models": "1.2.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "splitto-api"
  }
}